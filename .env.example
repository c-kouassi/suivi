# Serveur
PORT=3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
APP_BASE_URL=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=suivi_patient
DB_PORT=3306

# SMTP (emails de confirmation de compte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SuiviPatient <no-reply@example.com>"

# Groq LLM (chatbot)
# Sans GROQ_API_KEY le chatbot utilise la base de connaissances hors-ligne.
# GROQ_MODEL doit exister dans le catalogue Groq du compte (sinon 404 -> repli mots-cles).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
